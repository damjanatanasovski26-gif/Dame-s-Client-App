TRAINER_APP_ENV=development
TRAINER_APP_SECRET_KEY=replace-with-a-long-random-secret
TRAINER_DATABASE_URI=sqlite:///trainer.db

# Session/cookie security
SESSION_COOKIE_NAME=trainer_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0
FORCE_HTTPS=0

# App runtime
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
TRUST_PROXY=1

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCK_SECONDS=600

# Nutrition label OCR
# Prefer Google Vision in production. Keep this secret in Railway variables, not in git.
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_FEATURE_TYPE=DOCUMENT_TEXT_DETECTION
GOOGLE_VISION_LANGUAGE_HINTS=en,mk,sq

# ExerciseDB via RapidAPI for strength poster exercise images
RAPIDAPI_KEY=
EXERCISEDB_HOST=exercisedb.p.rapidapi.com

# Optional local fallback OCR
TESSERACT_CMD=
TESSERACT_LANGS=eng+mkd+sqi
